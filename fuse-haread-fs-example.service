[Unit]
Description=fuse haread-fs service
After=network.target

[Service]
Type=simple

ExecStartPre=-sh -c 'umount -l /lustre/storeAB 2>&1 > /dev/null || true'
ExecStart=/usr/bin/haread-fs /lustre/metproductionB,/lustre/storeB,/lustre/metproductionA,/lustre/storeA /lustre/lustreAB/  -f -o allow_other -f -o allow_other

Restart=on-failure


[Install]
WantedBy=default.target
